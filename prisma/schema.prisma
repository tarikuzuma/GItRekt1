// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

// Local dev runs on SQLite so the app works with zero infrastructure.
// To move to Supabase: switch provider back to "postgresql", set DATABASE_URL,
// and convert the JSON-string list fields below back to String[].
// Prisma 7: the connection URL lives in prisma.config.ts, and the client gets
// a driver adapter (see lib/prisma.ts).
datasource db {
  provider = "sqlite"
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // Hashed password for credentials-based auth (bcrypt)
  password      String?
  accounts      Account[]
  sessions      Session[]
  
  // Custom MVP fields for GitRekt
  university    String?
  course        String?
  // JSON-encoded string arrays: SQLite has no native list type.
  // Use parseList()/serializeList() from lib/json-list.ts at the API boundary.
  skills        String    @default("[]")
  interests     String    @default("[]")
  swipes        Swipe[]   @relation("ActorSwipes")
  receivedSwipes Swipe[]  @relation("TargetSwipes")
  teams         TeamMember[]
  sentMessages  ChatMessage[] @relation("SentMessages")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Team {
  id          String   @id @default(cuid())
  name        String
  description String?
  skillsNeeded String   @default("[]") // JSON-encoded string array
  members     TeamMember[]
  swipes      Swipe[]  @relation("TeamSwipes")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TeamMember {
  id     String @id @default(cuid())
  userId String
  teamId String
  role   String @default("MEMBER") // e.g., "LEAD", "MEMBER"
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
}

model Swipe {
  id         String   @id @default(cuid())
  actorId    String   // The User swiping
  targetUserId String? // The User being swiped on
  targetTeamId String? // The Team being swiped on
  targetType String   // "USER" or "TEAM"
  direction  String   // "LIKE" or "PASS"
  createdAt  DateTime @default(now())

  actor      User     @relation("ActorSwipes", fields: [actorId], references: [id], onDelete: Cascade)
  targetUser User?    @relation("TargetSwipes", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetTeam Team?    @relation("TeamSwipes", fields: [targetTeamId], references: [id], onDelete: Cascade)

  @@unique([actorId, targetUserId, targetTeamId])
}

model Event {
  id          String   @id @default(cuid())
  name        String
  description String?
  date        DateTime
  location    String?
  url         String?
  createdAt   DateTime @default(now())
}

/// Uploaded resume + the skill tags extracted from it.
/// Keyed by email rather than a User FK so uploads work before auth is wired up.
model Resume {
  id          String   @id @default(cuid())
  email       String   @unique
  fileKey     String
  fileName    String
  fileSize    Int      @default(0)
  contentType String   @default("application/pdf")
  pageCount   Int?
  /// JSON: [{ "label": "React", "category": "framework", "confidence": 0.9 }]
  tags        String   @default("[]")
  /// "gemini" or "heuristic" — which extractor produced the tags.
  tagSource   String   @default("heuristic")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChatMessage {
  id        String   @id @default(cuid())
  chatId    String   // e.g., "user1_user2"
  senderId  String
  content   String
  createdAt DateTime @default(now())

  sender    User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
}
